# Copy this file to .env when using docker compose from the repo root.

# Plaid sandbox credentials
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Use a long random value for anything beyond local testing.
JWT_SECRET=change_this_local_jwt_secret

# Local browser URL for the backend API.
# For LAN/port-forwarded access, replace localhost with the hostname or public IP
# that visitors will use, for example http://203.0.113.10:5000/api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Origins that the backend will allow. Comma-separated.
# Examples:
# FRONTEND_URLS=http://localhost:3000,http://192.168.1.50:3000
# FRONTEND_URLS=http://localhost:3000,http://203.0.113.10:3000
FRONTEND_URLS=http://localhost:3000

# Optional. Only set if this exact URI is configured in Plaid's allowed redirect URIs.
# PLAID_REDIRECT_URI=http://localhost:3000/callback
