PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financial_tracker

# Plaid
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
# Optional. Only set this if the exact URI is allowed in your Plaid dashboard.
# PLAID_REDIRECT_URI=http://localhost:3000/callback

# JWT
JWT_SECRET=your_jwt_secret_key

# Frontend URLs allowed by CORS. Use commas when exposing the app beyond localhost.
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
